# ======================================================================
# B2B Multi-Tenant AI SaaS (노무체크 AI) Environment Security Template
# ======================================================================

# Port & App Configuration
PORT=5000
NODE_ENV=development

# ----------------------------------------------------------------------
# 1. Supabase Database Configuration (Multi-Tenancy & RLS)
# ----------------------------------------------------------------------
SUPABASE_URL=https://your-supabase-project-id.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# ----------------------------------------------------------------------
# 2. Financial Grade AES-256 Encryption Key
# Generate 32 bytes (64 hex characters) key: e.g. using `openssl rand -hex 32`
# ----------------------------------------------------------------------
AES_SECRET_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# ----------------------------------------------------------------------
# 3. AI Engine Configuration (Privacy Mode & Zero Data Leakage)
# Providers: "OLLAMA" (Local Dedicated) | "GEMINI" (Cloud Zero-Data-Retention)
# ----------------------------------------------------------------------
AI_PROVIDER=OLLAMA

# Ollama Local AI Server Settings
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:14b
# Alternative local model: deepseek-r1:14b

# Google Gemini API Settings (When AI_PROVIDER=GEMINI)
GEMINI_API_KEY=your-google-gemini-api-key
GEMINI_MODEL=gemini-1.5-pro
